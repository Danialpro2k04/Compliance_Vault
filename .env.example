# ComplianceVault — Environment Configuration
# Copy this to .env and fill in your values

# ── TradeGuard Core Pipeline URL ──
TRADEGUARD_CORE_URL=http://localhost:8005

# ── ComplianceVault Settings ──
VAULT_PORT=8006
SECRET_KEY=compliance-vault-dev-key-change-me

# ── Simulation Mode (uses sample data) ──
SIMULATION_MODE=true
